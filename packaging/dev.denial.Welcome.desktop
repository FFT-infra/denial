[Desktop Entry]
Type=Application
Name=Welcome to Denial
Name[zh_CN]=欢迎使用 Denial
Comment=Discover shortcuts and make Denial your own
Comment[zh_CN]=了解快捷键并个性化设置 Denial
Exec=/usr/bin/denial-settings --welcome
TryExec=/usr/bin/denial-settings
Icon=preferences-desktop
Terminal=false
Categories=Settings;
Keywords=Welcome;Setup;Shortcuts;Layout;Theme;
StartupWMClass=dev.denial.Welcome
