#!/usr/bin/env bash
# Stage into a package root only. This never starts an agent or opens a dialog.
set -euo pipefail
ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
[[ $# == 3 && "$1" == /* && "$1" != / ]] || {
    printf 'Usage: stage-denial-polkit-agent ABSOLUTE_PACKAGE_ROOT BACKEND APP_BUNDLE\n' >&2
    exit 2
}
destination="$1" backend="$2" bundle="$3"
[[ -x "$backend" && -x "$bundle/denial-app" ]] || exit 1
for component in lib/libapp.so lib/libflutter_engine.so data/icudtl.dat data/flutter_assets/AssetManifest.bin; do
    [[ -f "$bundle/$component" ]] || exit 1
done
install -Dm755 "$backend" "$destination/usr/bin/denial-polkit-agent"
install -d "$destination/usr/lib/denial/polkit"
cp -a -- "$bundle/." "$destination/usr/lib/denial/polkit/"
chmod -R u=rwX,go=rX "$destination/usr/lib/denial/polkit"
install -Dm644 "$ROOT/packaging/denial-polkit-agent.service" \
    "$destination/usr/lib/systemd/user/denial-polkit-agent.service"
