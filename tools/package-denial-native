#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
ROOT="$(cd -- "$SCRIPT_DIR/.." && pwd)"

if [[ "${DENIAL_PACKAGE_SKIP_STAGE:-0}" != 1 ]]; then
  "$ROOT/tools/stage-denial-runtime"
fi
DENIAL_PACKAGE_SKIP_STAGE=1 "$ROOT/tools/package-denial-deb"
DENIAL_PACKAGE_SKIP_STAGE=1 "$ROOT/tools/package-denial-rpm"
